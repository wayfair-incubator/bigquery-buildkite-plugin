#!/bin/bash
set -euo pipefail

# retry <number-of-retries> <command>
function retry {
	local retries=$1
	shift
	local attempts=1
	local status=0

	until "$@"; do
		status=$?
		echo "Exited with $status"
		if ((retries == "0")); then
			return $status
		elif ((attempts == retries)); then
			echo "Failed $attempts retries"
			return $status
		else
			echo "Retrying $((retries - attempts)) more times..."
			attempts=$((attempts + 1))
			sleep $(((attempts - 2) * 2))
		fi
	done
}

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

debug_mode="false"
if [[ ${BUILDKITE_PLUGIN_BIGQUERY_DEBUG_MODE:-false} =~ (true|on|1) ]]; then
	echo "--- :hammer: Enabling debug mode"
	debug_mode="true"
fi

workdir="/workdir"

# Pinned: uv is installed inside the container on every run
uv_version="0.13.1"

default_image="python:3.15-slim"
image="${BUILDKITE_PLUGIN_BIGQUERY_CUSTOM_IMAGE:-$default_image}"

if [ -z "$BUILDKITE_PLUGIN_BIGQUERY_GCP_PROJECT" ]; then
	echo "ERROR: bigquery project (gcp_project) key not set"
	exit 1
fi

gcp_project="${BUILDKITE_PLUGIN_BIGQUERY_GCP_PROJECT}"

if [ -z "${BUILDKITE_PLUGIN_BIGQUERY_DATASET_SCHEMA_DIRECTORY}" ]; then
	echo "ERROR: dataset schema (dataset_schema_directory) not set"
	exit 1
fi

dataset_schema_directory="${BUILDKITE_PLUGIN_BIGQUERY_DATASET_SCHEMA_DIRECTORY}"

# Credentials: a service account key in `gcp_service_account`, or else Application
# Default Credentials (the metadata server of the agent's cloud identity, or the
# file named by GOOGLE_APPLICATION_CREDENTIALS, which is mounted read-only).
adc_credentials_file=""
if [ -n "${gcp_service_account:-}" ]; then
	echo "--- :key: Authenticating with the gcp_service_account key"
else
	echo "--- :key: gcp_service_account is not set, using Application Default Credentials"
	if [[ -n ${GOOGLE_APPLICATION_CREDENTIALS:-} ]]; then
		if [[ ! -f ${GOOGLE_APPLICATION_CREDENTIALS} ]]; then
			echo "ERROR: GOOGLE_APPLICATION_CREDENTIALS points to a file that does not exist: ${GOOGLE_APPLICATION_CREDENTIALS}"
			exit 1
		fi
		adc_credentials_file="${GOOGLE_APPLICATION_CREDENTIALS}"
	fi
fi

# plugin.yml booleans arrive as strings: normalise to true/false
function is_true {
	[[ ${1:-} =~ ^(true|on|yes|1)$ ]]
}

execute_only_changed_files="false"
if is_true "${BUILDKITE_PLUGIN_BIGQUERY_EXECUTE_ONLY_CHANGED_FILES:-false}"; then
	execute_only_changed_files="true"
fi

default_prod_build_branch="master"
prod_build_branch="${BUILDKITE_PLUGIN_BIGQUERY_PROD_BUILD_BRANCH:-$default_prod_build_branch}"

default_current_branch="non_master"
current_branch="${BUILDKITE_BRANCH:-$default_current_branch}"

# Changed files are only needed (and git is only consulted) when deploying
# just the changed files. Paths are relative to the current directory, which is
# also the working directory inside the container.
changed_files=""
is_default_branch="false"

# list_changed_files <diff|diff-tree> <git-args...>: print changed paths under $PWD
function list_changed_files {
	git "$1" --relative --diff-filter=ABMRT --name-only -z "${@:2}" | tr '\0' '\n'
}

if [[ ${execute_only_changed_files} == "true" ]]; then
	raw_files=""
	if [[ ${prod_build_branch} == "${current_branch}" ]]; then
		is_default_branch="true"
		echo "--- :git: Detecting changed files on default branch (${current_branch})"

		if git rev-parse --verify -q HEAD^ >/dev/null; then
			# For the default branch, compare with the parent commit
			if ! raw_files=$(list_changed_files diff-tree --no-commit-id -r HEAD^..HEAD); then
				echo "ERROR: could not list the files changed in the last commit"
				exit 1
			fi
		else
			echo "⚠️  First commit detected, will process all files"
			execute_only_changed_files="false"
		fi
	else
		echo "--- :git: Detecting changed files on feature branch (${current_branch})"

		# For feature branches, compare with the base branch
		base_branch="origin/${prod_build_branch}"
		if ! git rev-parse --verify -q "$base_branch" >/dev/null; then
			# Shallow checkouts often lack the base branch
			git fetch --quiet origin "${prod_build_branch}" >/dev/null 2>&1 || true
		fi

		if git rev-parse --verify -q "$base_branch" >/dev/null; then
			# Three-dot syntax compares against the merge-base
			if ! raw_files=$(list_changed_files diff "${base_branch}...HEAD"); then
				echo "ERROR: could not compare with ${base_branch}"
				exit 1
			fi
		elif git rev-parse --verify -q HEAD^ >/dev/null; then
			echo "⚠️  Warning: Could not find base branch $base_branch"
			echo "⚠️  Falling back to comparing with HEAD^ (only the last commit)"
			if ! raw_files=$(list_changed_files diff-tree --no-commit-id -r HEAD^..HEAD); then
				echo "ERROR: could not list the files changed in the last commit"
				exit 1
			fi
		else
			echo "⚠️  No base branch and no parent commit, will process all files"
			execute_only_changed_files="false"
		fi
	fi

	if [[ ${execute_only_changed_files} == "true" ]]; then
		# Keep only paths that still exist, as a newline-separated list
		while IFS= read -r file; do
			if [[ -n $file && -e $file ]]; then
				changed_files="${changed_files}${file}"$'\n'
			fi
		done <<<"$raw_files"
		changed_files="${changed_files%$'\n'}"

		if [[ -n $changed_files ]]; then
			file_count=$(printf '%s\n' "$changed_files" | wc -l)
			echo "📝 Detected ${file_count} changed file(s)"
		else
			echo "ℹ️  No changed files detected, nothing will be deployed"
		fi
	fi
fi

# collect_list <NAME>: join BUILDKITE_PLUGIN_BIGQUERY_<NAME>_0, _1, ... (a plugin
# array) into a newline-separated string
function collect_list {
	local i=0 name joined=""
	while true; do
		name="BUILDKITE_PLUGIN_BIGQUERY_${1}_${i}"
		if [[ -z ${!name+x} ]]; then
			break
		fi
		joined="${joined}${!name}"$'\n'
		i=$((i + 1))
	done
	printf '%s' "${joined%$'\n'}"
}

include_patterns=$(collect_list INCLUDE)
exclude_patterns=$(collect_list EXCLUDE)

annotate="false"
if is_true "${BUILDKITE_PLUGIN_BIGQUERY_ANNOTATE:-false}"; then
	annotate="true"
fi
annotation_context="${BUILDKITE_PLUGIN_BIGQUERY_ANNOTATION_CONTEXT:-bigquery}"

default_fail_pipeline_on_first_exception="true"
fail_pipeline_on_first_exception="false"
if is_true "${BUILDKITE_PLUGIN_BIGQUERY_FAIL_PIPELINE_ON_FIRST_EXCEPTION:-$default_fail_pipeline_on_first_exception}"; then
	fail_pipeline_on_first_exception="true"
fi

if [[ ${debug_mode} == "true" ]]; then
	echo "Configuration:"
	echo "GCP Project: ${gcp_project}"
	echo "Dataset Schema Directory: ${dataset_schema_directory}"
	echo "Execute Only Changed Files: ${execute_only_changed_files}"
	echo "Fail Pipeline on First Exception: ${fail_pipeline_on_first_exception}"
	echo "Include: ${include_patterns:-<all>}"
	echo "Exclude: ${exclude_patterns:-<none>}"
	echo "Changed Files: ${changed_files}"
	echo "Is Default Branch: ${is_default_branch}"
	echo "Docker Image: ${image}"
fi

# No `--rm`: the container must outlive the run so the annotation can be copied
# out of it; the EXIT trap below removes it.
args=("--init" "--workdir" "${workdir}")

# Only an allowlist of variables reaches the container. The container runs code
# installed from PyPI, so it must not see the rest of the job environment (other
# secrets, the agent access token). `--env NAME` without a value copies the
# value from this process's environment, which keeps secrets off the command line.
for proxy_var in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
	if [[ -n ${!proxy_var:-} ]]; then
		args+=(--env "${proxy_var}")
	fi
done

args+=(
	"--env" "dataset_schema_directory=$dataset_schema_directory"
	"--env" "gcp_project=$gcp_project"
	"--env" "execute_only_changed_files=$execute_only_changed_files"
	"--env" "fail_pipeline_on_first_exception=$fail_pipeline_on_first_exception"
	"--env" "updated_files=$changed_files"
	"--env" "include_patterns=$include_patterns"
	"--env" "exclude_patterns=$exclude_patterns"
)

annotation_container_file="/tmp/bigquery-annotation.md"
if [[ ${annotate} == "true" ]]; then
	args+=("--env" "annotation_file=${annotation_container_file}")
fi

if [[ -n ${gcp_service_account:-} ]]; then
	args+=("--env" "credentials")
elif [[ -n $adc_credentials_file ]]; then
	args+=(
		"--volume" "${adc_credentials_file}:/run/secrets/google-adc.json:ro"
		"--env" "GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-adc.json"
	)
fi

# Add the image in before the shell and command
args+=("${image}")

# Assemble the shell and command arguments into the docker arguments
command=()
display_command=()

shell=("/bin/sh" "-e" "-c")
args+=("${shell[@]}")
display_command+=("${shell[@]}")
command+=("pip install --quiet uv==${uv_version} && uv pip install --system -q --require-hashes -r plugin_scripts/requirements.lock && python -m plugin_scripts.__init__")

# join command lines
command_string="$(
	IFS=$'\n'
	echo "${command[*]}"
)"

args+=("${command_string}")
display_command+=("'${command_string}'")

echo "--- :docker: Pulling ${image}"
rv=0
retry "${BUILDKITE_PLUGIN_BIGQUERY_DOCKER_PULL_RETRIES:-3}" docker pull "${image}" || rv=$?
if ((rv != 0)); then
	echo "--- :docker: Pull failed."
	exit "$rv"
fi

echo '--- :docker: Logging "docker create" command'
echo "$ docker create" >&2

echo "--- :docker: Running command in ${image}"
echo "$ ${display_command[*]}" >&2

if [[ ${debug_mode} == "true" ]]; then
	echo "docker create" >&2
	echo "docker cp \"${PWD}/.\" \"dockerContainerID:${workdir}\"" >&2
fi

# # For copy-checkout, we have to `docker create`, then `docker cp "${PWD}:${workdir}"`, then `docker start`
DOCKERID=$(credentials="${gcp_service_account:-}" docker create "${args[@]}")
annotation_tmp=""
function cleanup {
	docker rm -f "${DOCKERID}" >/dev/null 2>&1 || true
	if [[ -n $annotation_tmp ]]; then
		rm -f "$annotation_tmp"
	fi
}
trap cleanup EXIT
docker cp "${PWD}/." "${DOCKERID}:${workdir}"
docker cp "${PLUGIN_DIR}/plugin_scripts" "${DOCKERID}:${workdir}/plugin_scripts"

rv=0
docker start -a "${DOCKERID}" || rv=$?

# Annotate from the host so the container never needs the agent or its token.
# A problem here must not change the result of the deployment itself.
if [[ ${annotate} == "true" ]]; then
	if ! command -v buildkite-agent >/dev/null 2>&1; then
		echo "⚠️  annotate is set but buildkite-agent was not found, skipping the annotation"
	else
		annotation_tmp=$(mktemp)
		if docker cp "${DOCKERID}:${annotation_container_file}" "$annotation_tmp" >/dev/null 2>&1; then
			style="success"
			if ((rv != 0)); then
				style="error"
			fi
			buildkite-agent annotate --style "$style" --context "$annotation_context" <"$annotation_tmp" ||
				echo "⚠️  Could not create the annotation"
		else
			echo "⚠️  No deployment summary was produced, skipping the annotation"
		fi
	fi
fi

exit "$rv"
